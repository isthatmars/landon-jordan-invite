# Admin access code (cookie-gated /admin)
ADMIN_ACCESS_CODE=NEON80S

# --- Ship now: Resend email (live when key is set) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=party@yourdomain.com
# OWNER_EMAIL can be a comma-separated list (semicolons work too).
# Each address receives the owner RSVP alert. Guest confirmation still goes only to the guest.
OWNER_EMAIL=you@example.com

# Public site URL for email CTAs
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Defer live SMS ---
# Keep SMS composer UI; default none. Later: webhook → Zapier/Make → SimpleTexting.
SMS_PROVIDER=none

# Optional later: SimpleTexting via Zapier/Make Catch Hook (guest list stays in /admin)
WEBHOOK_FORWARD_URL=
WEBHOOK_FORWARD_SECRET=
WEBHOOK_FORWARD_ON_DRAFT=false

# Optional later: Twilio owner-only trial (skip A2P) — not required for launch
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
OWNER_PHONE=

# Supabase RSVP + Photo Booth storage (SAME project). Server only.
# Do not prefix the service role with NEXT_PUBLIC_.
# Project: landon-jordan-invite
# URL: https://ezuqjqdeqmdwumcqvksi.supabase.co
# Service role: Supabase dashboard → Project Settings → API Keys → service_role
# Preview + Production both need these or gallery save returns 503 on Vercel.
SUPABASE_URL=https://ezuqjqdeqmdwumcqvksi.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Photo Booth AI (Gemini preferred; OpenArt optional fallback) ---
# Prefer Gemini for production. Create a key at https://aistudio.google.com/apikey
# Set on Vercel Preview + Production. Never prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=
# Alias also accepted: GOOGLE_GENERATIVE_AI_API_KEY=
# Optional Gemini overrides (Production defaults):
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# GEMINI_IMAGE_ASPECT_RATIO=16:9
# GEMINI_IMAGE_SIZE=2K
# IMAGE_GENERATION_CONCURRENCY=3
#
# Optional OpenArt fallback — OAuth access token from `openart login`
# (~/.openart/cli-credentials.json → access_token / accessToken / token).
OPENART_TOKEN=
# OPENART_API_BASE=https://openart.ai
# OPENART_IMAGE_MODEL=nano-banana-2
# Local smoke tests without a provider (sharp 80s grade — not production AI):
# BOOTH_MOCK_AI=1
# BOOTH_DEV_OTP=1
# BOOTH_EXPOSE_OTP=1
# BOOTH_CLEANUP_SECRET=
