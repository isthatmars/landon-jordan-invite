# Admin access code (cookie-gated /admin)
ADMIN_ACCESS_CODE=NEON80S

# --- Ship now: Resend email (live when key is set) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=party@yourdomain.com
# OWNER_EMAIL can be a comma-separated list (semicolons work too).
# Each address receives the owner RSVP alert. Guest confirmation still goes only to the guest.
OWNER_EMAIL=you@example.com

# Public site URL for email CTAs
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Defer live SMS ---
# Keep SMS composer UI; default none. Later: webhook → Zapier/Make → SimpleTexting.
SMS_PROVIDER=none

# Optional later: SimpleTexting via Zapier/Make Catch Hook (guest list stays in /admin)
WEBHOOK_FORWARD_URL=
WEBHOOK_FORWARD_SECRET=
WEBHOOK_FORWARD_ON_DRAFT=false

# Optional later: Twilio owner-only trial (skip A2P) — not required for launch
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
OWNER_PHONE=

# Supabase RSVP storage. Server only. Do not prefix the service role with NEXT_PUBLIC_.
# URL: https://ezuqjqdeqmdwumcqvksi.supabase.co
# Service role: Supabase dashboard → Project Settings → API Keys → service_role
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
