# Admin access code (cookie-gated /admin)
ADMIN_ACCESS_CODE=NEON80S

# Primary notifications — Resend email
RESEND_API_KEY=
RESEND_FROM_EMAIL=party@yourdomain.com
OWNER_EMAIL=you@example.com

# SMS: email-first. Default none (guest SMS off).
# Options: none | twilio_owner_only | whatsapp_stub | export_csv | loopmessage_stub | textmagic_stub
SMS_PROVIDER=none

# Hybrid SMS (optional): Resend = email; webhook = Zapier/Make → SimpleTexting or TextMagic
# Our /admin stays the ONLY guest list — do not use Fillout as primary RSVP dashboard.
# Leave WEBHOOK_FORWARD_URL unset to skip (stub).
WEBHOOK_FORWARD_URL=
WEBHOOK_FORWARD_SECRET=
WEBHOOK_FORWARD_ON_DRAFT=false

# Optional owner-only SMS alerts (Twilio trial + verified numbers is enough — skip A2P 10DLC)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
OWNER_PHONE=

# Future Supabase (RSVP persistence)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL for email CTAs
NEXT_PUBLIC_SITE_URL=http://localhost:3000
